PORT=8080
APP_ENV=development
DATABASE_URL=
JWT_SECRET_ACCESS=
JWT_SECRET_REFRESH=
JWT_SECRET_OAUTH_STATE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_URL=http://localhost:5173

# Production sets this to 127.0.0.1 (nginx runs on the same droplet, see
# nginx/packing-list-api.conf) so Gin trusts its X-Forwarded-For header.
# Local dev has no reverse proxy in front, so leave unset.
TRUSTED_PROXIES=

# Auto-populated by `go run scripts/gen_token.go`; used by requests/*.http
# via {{$dotenv DEV_TOKEN}}. No need to set this manually.
DEV_TOKEN=