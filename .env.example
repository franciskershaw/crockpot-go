PORT=8080
APP_ENV=development
DATABASE_URL=
JWT_SECRET_ACCESS=
JWT_SECRET_REFRESH=
JWT_SECRET_OAUTH_STATE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Recipe photos upload here; cleanup only destroys under this folder
# (plus the legacy Crockpot/ and recipes/ folders in production).
# Production: recipes. Local dev: dev/recipes.
CLOUDINARY_UPLOAD_FOLDER=

# Production sets this to 127.0.0.1 (nginx runs on the same droplet in
# front of this API) so Gin trusts its X-Forwarded-For header. Local dev
# has no reverse proxy in front, so leave unset.
TRUSTED_PROXIES=