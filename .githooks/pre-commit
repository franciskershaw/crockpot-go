#!/usr/bin/env bash
# Fast, local-only checks — gofmt/tidy auto-fix and re-stage, vet/build
# block the commit. Wrapped in a stash so every check sees only the
# staged snapshot, not unstaged working-tree changes — otherwise an
# unrelated unstaged edit (or a dependency mid-piece, before its
# importing file is staged) could get swept into the commit. Slower/
# DB-dependent checks (golangci-lint, govulncheck, repository
# integration tests) stay CI-only — see CLAUDE.md's "Pre-commit hook"
# section.
set -euo pipefail

# GUI git clients launch hooks via launchd's bare PATH, not the login shell's —
# neither go nor gofmt resolve there even though they work from any terminal.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

stash_count_before=$(git stash list | wc -l)
git stash push --keep-index --include-untracked --quiet -m "pre-commit: unstaged snapshot" || true
stash_count_after=$(git stash list | wc -l)
stashed=0
if [ "$stash_count_after" -gt "$stash_count_before" ]; then
	stashed=1
fi
restore() {
	if [ "$stashed" -eq 1 ]; then
		git stash pop --quiet
	fi
}
trap restore EXIT

echo "pre-commit: gofmt"
staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$staged_go_files" ]; then
	fmt_files=$(echo "$staged_go_files" | xargs gofmt -l)
	if [ -n "$fmt_files" ]; then
		echo "$fmt_files" | xargs gofmt -w
		echo "$fmt_files" | xargs git add
		echo "pre-commit: reformatted and re-staged:"
		echo "$fmt_files"
	fi
fi

echo "pre-commit: go vet"
go vet ./...

echo "pre-commit: go build"
go build ./...

echo "pre-commit: go mod tidy"
before_mod=$(git hash-object go.mod)
before_sum=$(git hash-object go.sum)
go mod tidy
after_mod=$(git hash-object go.mod)
after_sum=$(git hash-object go.sum)
if [ "$before_mod" != "$after_mod" ] || [ "$before_sum" != "$after_sum" ]; then
	git add go.mod go.sum
	echo "pre-commit: go.mod/go.sum updated by tidy and re-staged"
fi

echo "pre-commit: all checks passed"
