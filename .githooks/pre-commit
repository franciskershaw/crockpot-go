#!/usr/bin/env bash
# Fast, local-only checks against the staged snapshot only, exported to a
# temp dir so the working tree is never stashed, popped or rewritten.
# Slower/DB-dependent checks (golangci-lint, govulncheck, repository
# integration tests) stay CI-only — see CLAUDE.md's "Pre-commit hook"
# section.
set -euo pipefail

# GUI git clients launch hooks via launchd's bare PATH, not the login shell's —
# neither go nor gofmt resolve there even though they work from any terminal.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')

snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"
cd "$snapshot"

echo "pre-commit: gofmt"
if [ -n "$staged_go_files" ]; then
	unformatted=$(echo "$staged_go_files" | xargs gofmt -l)
	if [ -n "$unformatted" ]; then
		echo "pre-commit: not gofmt'd — run gofmt -w on these and stage them:"
		echo "$unformatted"
		exit 1
	fi
fi

echo "pre-commit: go vet"
go vet ./...

echo "pre-commit: go build"
go build ./...

echo "pre-commit: go mod tidy"
if ! go mod tidy -diff; then
	echo "pre-commit: go.mod/go.sum aren't tidy — run go mod tidy and stage both"
	exit 1
fi

echo "pre-commit: all checks passed"
